# Environment variables for Brain Server

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# ChromaDB Configuration
CHROMA_PERSIST_DIRECTORY=./vector_db
COLLECTION_NAME=obsidian_notes

# File Watching (Update with your Obsidian vault path)
WATCH_DIRECTORY=C:/Users/camar/path/to/obsidian/vault

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Optional: ElevenLabs for TTS (used by Edge Client)
ELEVENLABS_API_KEY=your_api_key_here

# RAG agent (set false to use one-shot retrieve → generate)
AGENTIC_RAG=true

# Logging
LOG_LEVEL=INFO
